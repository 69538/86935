        List<String> videoOptions = new ArrayList<>();
        List<TrackSelectionOverride> videoOverrides = new ArrayList<>();
        videoOptions.add("Auto (Adaptive Video)");
        List<String> audioOptions = new ArrayList<>();
        List<TrackSelectionOverride> audioOverrides = new ArrayList<>();
        audioOptions.add("Auto (Default Audio)");
        for (Tracks.Group group : currentTracks.getGroups()) {
            TrackGroup mediaTrackGroup = group.getMediaTrackGroup();
            if (group.getType() == C.TRACK_TYPE_VIDEO) {
                for (int i = 0; i < mediaTrackGroup.length; i++) {
                    if (group.isTrackSupported(i)) {
                        androidx.media3.common.Format format = mediaTrackGroup.getFormat(i);
                        String label = format.height + "p (" + (format.bitrate / 1000) + " kbps)";
                        videoOptions.add(label);
                        videoOverrides.add(new TrackSelectionOverride(mediaTrackGroup, i));
                    }
                }
            } else if (group.getType() == C.TRACK_TYPE_AUDIO) {
                for (int i = 0; i < mediaTrackGroup.length; i++) {
                    if (group.isTrackSupported(i)) {
                        androidx.media3.common.Format format = mediaTrackGroup.getFormat(i);
                        String langName = "Unknown Language";
                        if (format.language != null) {
                            java.util.Locale locale = new java.util.Locale(format.language);
                            langName = locale.getDisplayLanguage().toUpperCase();
                        }
                        String bitrateDetails = "";
                        if (format.bitrate > 0) {
                            if (format.bitrate >= 1000000) {
                                double mbps = (double) format.bitrate / 1000000.0;
                                bitrateDetails = String.format(java.util.Locale.US, ", %.2f Mbps", mbps);
                            } else {
                                int kbps = format.bitrate / 1000;
                                bitrateDetails = ", " + kbps + " kbps";
                            }
                        }
                        String channels = format.channelCount == 2 ?
                                " Stereo" : (format.channelCount > 2 ? " Surround" : "");
