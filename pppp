            if (isSelected) {
                holder.cardBadge.setCardBackgroundColor(Color.parseColor("#2754F5"));
                holder.tvTitle.setTextColor(Color.parseColor("#FFFFFF"));
            } else {
                holder.cardBadge.setCardBackgroundColor(Color.parseColor("#22FFFFFF"));
                holder.tvTitle.setTextColor(Color.parseColor("#FFFFFF"));
