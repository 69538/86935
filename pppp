    public class QuickChannelAdapter extends RecyclerView.Adapter<QuickChannelAdapter.ViewHolder> {
        private final List<ChannelItem> channelList;
        private final OnQuickChannelClickListener listener;

        public QuickChannelAdapter(List<ChannelItem> channelList, OnQuickChannelClickListener listener) {
            this.channelList = channelList;
            this.listener = listener;
        }

        @NonNull
        @Override
        public ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
            View view = LayoutInflater.from(parent.getContext()).inflate(R.layout.item_quick_channel, parent, false);
            return new ViewHolder(view);
        }

        @Override
        public void onBindViewHolder(@NonNull ViewHolder holder, int position) {
            ChannelItem channel = channelList.get(position);

            holder.tvName.setText((position + 1) + " • " + (channel.getName() != null ? channel.getName() : "Channel"));
            holder.tvGroup.setText(channel.getGroupTitle() != null ? channel.getGroupTitle() : "Live TV");

            holder.ivLogo.setImageResource(R.drawable.image_channel_loader);

            if (channel.getLogoUrl() != null && !channel.getLogoUrl().trim().isEmpty()) {
                final String logoUrl = channel.getLogoUrl().trim();
                holder.ivLogo.setTag(logoUrl);

                new Thread(() -> {
                    try {
                        java.net.URL url = new java.net.URL(logoUrl);
                        java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
                        conn.setConnectTimeout(2500);
                        conn.setReadTimeout(2500);
                        conn.connect();

                        if (conn.getResponseCode() == java.net.HttpURLConnection.HTTP_OK) {
                            java.io.InputStream in = conn.getInputStream();
                            final Bitmap bmp = BitmapFactory.decodeStream(in);
                            in.close();

                            if (bmp != null) {
                                runOnUiThread(() -> {
                                    if (logoUrl.equals(holder.ivLogo.getTag())) {
                                        holder.ivLogo.setImageBitmap(bmp);
                                    }
                                });
                            }
                        }
                    } catch (Exception ignored) {}
                }).start();
            }

            holder.itemView.setOnClickListener(v -> {
                if (listener != null) {
                    listener.onChannelClick(channel, position);
                }
            });
        }

        @Override
        public int getItemCount() {
            return channelList != null ? channelList.size() : 0;
        }

        class ViewHolder extends RecyclerView.ViewHolder {
            ImageView ivLogo, ivPlaying;
            TextView tvName, tvGroup;

            ViewHolder(@NonNull View itemView) {
                super(itemView);
                ivLogo = itemView.findViewById(R.id.iv_quick_logo);
                ivPlaying = itemView.findViewById(R.id.iv_now_playing_indicator);
                tvName = itemView.findViewById(R.id.tv_quick_channel_name);
                tvGroup = itemView.findViewById(R.id.tv_quick_channel_group);
            }
        }
    }
