    private String getCurrentPlayingQuality() {
        if (player == null) return "AUTO HD";
        try {
            androidx.media3.common.Format format = player.getVideoFormat();
            if (format != null && format.height > 0) {
                int h = format.height;
                if (h >= 2160) return "4K UHD";
                if (h >= 1080) return "1080p FHD";
                if (h >= 720) return "720p HD";
                if (h >= 576) return "576p SD";
                if (h >= 480) return "480p SD";
                return h + "p";
            }
        } catch (Exception ignored) {}
        return "AUTO HD";
    }

    private String getCurrentPlayingAudio() {
        if (player == null) return "STEREO";
        try {
            androidx.media3.common.Format format = player.getAudioFormat();
            if (format != null) {
                if (format.channelCount > 2) return "5.1 DOLBY";
                if (format.channelCount == 2) return "STEREO";
                if (format.channelCount == 1) return "MONO";
            }
        } catch (Exception ignored) {}
        return "STEREO";
    }

    private void handleNumberZappingInput(int digit) {
        if (isScreenLocked) return;

        // Hide other overlays if active
        hideDthOverlayImmediately();
        hideQuickMenu();

        channelNumberBuilder.append(digit);

        // Show on-screen zapping HUD (Aap ise layout me bhi add kar sakte hain)
        showNumberZappingHud(channelNumberBuilder.toString());

        if (numberZappingRunnable != null) {
            numberZappingHandler.removeCallbacks(numberZappingRunnable);
        }

        numberZappingRunnable = () -> {
            executeChannelJump(channelNumberBuilder.toString());
            channelNumberBuilder.setLength(0); // Reset buffer
        };

        // User ke 1.5 seconds rukne par channel switch ho jayega
        numberZappingHandler.postDelayed(numberZappingRunnable, 1500);
    }

    private void executeChannelJump(String numberStr) {
        hideNumberZappingHud();
        try {
            int targetNumber = Integer.parseInt(numberStr);
            int targetIndex = targetNumber - 1; // 1-based index to 0-based index

            if (LiveTvActivity.staticChannelList != null && !LiveTvActivity.staticChannelList.isEmpty()) {
                if (targetIndex >= 0 && targetIndex < LiveTvActivity.staticChannelList.size()) {
                    LiveTvActivity.staticCurrentIndex = targetIndex;
                    ChannelItem channel = LiveTvActivity.staticChannelList.get(targetIndex);
                    if (channel != null && channel.getStreamUrl() != null) {
                        prepareAndPlay(channel.getStreamUrl(), false);
                        showDthInfoOverlay(channel, LiveTvActivity.staticCurrentIndex);
                    }
                } else {
                    Toast.makeText(this, "Channel " + targetNumber + " not found", Toast.LENGTH_SHORT).show();
                }
            }
        } catch (Exception e) {
            channelNumberBuilder.setLength(0);
        }
    }

