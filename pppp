    private void setupSwipeGestures() {
        if (playerView == null) return;
        gestureHideRunnable = () -> {
            if (premiumGestureHud != null) premiumGestureHud.setVisibility(View.GONE);
        };

        playerView.setOnTouchListener(new View.OnTouchListener() {
            private float startX, startY;
            private float baseVolume, baseBrightness;
            private boolean isThresholdPassed = false;

            private int currentSequentialPercent = 0;
            private float accumulatedDeltaY = 0f;
            private final float SWIPE_THRESHOLD = 40;
            private final float PIXELS_PER_STEP = 15f;

            @Override
            public boolean onTouch(View v, MotionEvent event) {
                if (isScreenLocked) return false;

                DisplayMetrics displayMetrics = getResources().getDisplayMetrics();
                int screenWidth = displayMetrics.widthPixels;
                AudioManager audioManager = (AudioManager) getSystemService(Context.AUDIO_SERVICE);
                WindowManager.LayoutParams layoutParams = getWindow().getAttributes();

                switch (event.getAction()) {
                    case MotionEvent.ACTION_DOWN:
                        startX = event.getX();
                        startY = event.getY();
                        isThresholdPassed = false;
                        accumulatedDeltaY = 0f;

                        if (audioManager != null) {
                            int maxVol = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
                            int curVol = audioManager.getStreamVolume(AudioManager.STREAM_MUSIC);
                            baseVolume = curVol;
                            currentSequentialPercent = (int) (((float) curVol / maxVol) * 100);
                        }

                        float sysBright = layoutParams.screenBrightness;
                        baseBrightness = sysBright < 0 ? 0.5f : sysBright;
                        if (startX <= (screenWidth / 2)) {
                            currentSequentialPercent = (int) (baseBrightness * 100);
                        }
                        return false;
                    case MotionEvent.ACTION_MOVE:
                        float deltaX = event.getX() - startX;
                        float deltaY = startY - event.getY();

                        if (!isThresholdPassed) {
                            if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > SWIPE_THRESHOLD) {
                                isThresholdPassed = true;
                                startY = event.getY();
                                accumulatedDeltaY = 0f;
                            }
                        }

                        if (isThresholdPassed) {
                            gestureHideHandler.removeCallbacks(gestureHideRunnable);
                            if (premiumGestureHud != null)
                                premiumGestureHud.setVisibility(View.VISIBLE);
                            float stepDiff = event.getY() - startY;
                            startY = event.getY();
                            accumulatedDeltaY -= stepDiff;
                            while (Math.abs(accumulatedDeltaY) >= PIXELS_PER_STEP) {
                                if (accumulatedDeltaY > 0) {
                                    currentSequentialPercent++;
                                    accumulatedDeltaY -= PIXELS_PER_STEP;
                                } else {
                                    currentSequentialPercent--;
                                    accumulatedDeltaY += PIXELS_PER_STEP;
                                }
                            }

                            if (currentSequentialPercent > 100) currentSequentialPercent = 100;
                            if (currentSequentialPercent < 0) currentSequentialPercent = 0;

                            if (startX > (screenWidth / 2)) {
                                if (audioManager != null) {
                                    int maxVol = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
                                    int targetVolumeValue = (int) (((float) currentSequentialPercent / 100f) * maxVol);
                                    audioManager.setStreamVolume(AudioManager.STREAM_MUSIC, targetVolumeValue, 0);
                                    if (imgPremiumIconHud != null) {
                                        imgPremiumIconHud.setImageResource(R.drawable.ic_volume_hud);
                                    }
                                    if (txtPremiumPercentage != null) {
                                        txtPremiumPercentage.setText(currentSequentialPercent + "%");
                                    }
                                    if (hudCircularProgress != null) {
                                        hudCircularProgress.setMax(10000);
                                        hudCircularProgress.setProgress(currentSequentialPercent * 100);
                                    }
                                }
                            } else {
                                float targetBrightnessValue = (float) currentSequentialPercent / 100f;
                                if (targetBrightnessValue > 1.0f) targetBrightnessValue = 1.0f;
                                if (targetBrightnessValue < 0.01f) targetBrightnessValue = 0.01f;
                                layoutParams.screenBrightness = targetBrightnessValue;
                                getWindow().setAttributes(layoutParams);

                                if (imgPremiumIconHud != null) {
                                    imgPremiumIconHud.setImageResource(R.drawable.ic_brightness_hud);
                                }
                                if (txtPremiumPercentage != null) {
                                    txtPremiumPercentage.setText(currentSequentialPercent + "%");
                                }
                                if (hudCircularProgress != null) {
                                    hudCircularProgress.setMax(10000);
                                    hudCircularProgress.setProgress(currentSequentialPercent * 100);
                                }
                            }

                            v.getParent().requestDisallowInterceptTouchEvent(true);
                            return true;
                        }
                        break;
                    case MotionEvent.ACTION_UP:
                        if (isThresholdPassed) {
                            gestureHideHandler.removeCallbacks(gestureHideRunnable);
                            gestureHideHandler.postDelayed(gestureHideRunnable, 1200);
                            return true;
                        }
                        break;
                }
                return isThresholdPassed;
            }
        });
    }

