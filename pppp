    private void setupQuickChannelMenu() {
        quickMenuOverlay = findViewById(R.id.quick_channel_menu_overlay);
        etQuickSearch = findViewById(R.id.et_quick_search);
        rvQuickCategories = findViewById(R.id.rv_quick_categories);
        rvQuickChannels = findViewById(R.id.rv_quick_channels);
        rvQuickChannels.setPreserveFocusAfterLayout(true);
        rvQuickChannels.setItemAnimator(null);
        ImageView btnClose = findViewById(R.id.btn_close_quick_menu);

        if (quickMenuOverlay == null) return;

        if (btnClose != null) {
            btnClose.setOnClickListener(v -> hideQuickMenu());
        }

        categoryList.clear();
        categoryList.add("ALL");
        if (LiveTvActivity.staticChannelList != null) {
            for (ChannelItem ch : LiveTvActivity.staticChannelList) {
                String group = ch.getGroupTitle();
                if (group != null && !group.trim().isEmpty() && !categoryList.contains(group.trim())) {
                    categoryList.add(group.trim());
                }
            }
        }

        quickCategoryAdapter = new QuickCategoryAdapter(categoryList, cat -> {
            selectedCategory = cat;
            filterChannels(etQuickSearch.getText().toString());

            if (rvQuickChannels != null) {
                rvQuickChannels.scrollToPosition(0);

                if (isTvDevice(PlayerActivity.this)) {
                    rvQuickChannels.postDelayed(() -> {
                        RecyclerView.ViewHolder holder = rvQuickChannels.findViewHolderForAdapterPosition(0);
                        if (holder != null) {
                            holder.itemView.requestFocus();
                        } else if (rvQuickChannels.getChildCount() > 0) {
                            rvQuickChannels.getChildAt(0).requestFocus();
                        }
                    }, 50);
                }
            }
        });
        rvQuickCategories.setAdapter(quickCategoryAdapter);

        displayedChannels = new ArrayList<>();
        if (LiveTvActivity.staticChannelList != null) {
            displayedChannels.addAll(LiveTvActivity.staticChannelList);
        }

        quickChannelAdapter = new QuickChannelAdapter(displayedChannels, (channel, index) -> {
            if (channel != null && channel.getStreamUrl() != null) {
                LiveTvActivity.staticCurrentIndex = LiveTvActivity.staticChannelList.indexOf(channel);
                prepareAndPlay(channel.getStreamUrl(), false);
                showDthInfoOverlay(channel, LiveTvActivity.staticChannelList.indexOf(channel));
                hideQuickMenu();
            }
        });
        rvQuickChannels.setAdapter(quickChannelAdapter);

        etQuickSearch.addTextChangedListener(new android.text.TextWatcher() {
            @Override
            public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
            @Override
            public void onTextChanged(CharSequence s, int start, int before, int count) {
                filterChannels(s.toString());
            }
            @Override
            public void afterTextChanged(android.text.Editable s) {}
        });
    }

    private void filterChannels(String query) {
        displayedChannels.clear();
        if (LiveTvActivity.staticChannelList != null) {
            for (ChannelItem item : LiveTvActivity.staticChannelList) {
                boolean matchesCategory = selectedCategory.equals("ALL") ||
                        (item.getGroupTitle() != null && item.getGroupTitle().equalsIgnoreCase(selectedCategory));
                boolean matchesSearch = query == null || query.trim().isEmpty() ||
                        (item.getName() != null && item.getName().toLowerCase().contains(query.toLowerCase().trim()));

                if (matchesCategory && matchesSearch) {
                    displayedChannels.add(item);
                }
            }
        }
        if (quickChannelAdapter != null) {
            quickChannelAdapter.notifyDataSetChanged();
        }
    }

    private boolean isTvDevice(Context context) {
        try {
            if (context.getPackageManager().hasSystemFeature(android.content.pm.PackageManager.FEATURE_LEANBACK)) return true;
            android.app.UiModeManager uiModeManager = (android.app.UiModeManager) context.getSystemService(Context.UI_MODE_SERVICE);
            if (uiModeManager != null && uiModeManager.getCurrentModeType() == android.content.res.Configuration.UI_MODE_TYPE_TELEVISION) return true;
            return context.getPackageManager().hasSystemFeature("android.hardware.type.television");
        } catch (Exception e) {
            return false;
        }
    }

    public void toggleQuickMenu() {
        if (isScreenLocked) return;
        if (quickMenuOverlay == null) return;
        if (quickMenuOverlay.getVisibility() == View.VISIBLE) {
            hideQuickMenu();
        } else {
            showQuickMenu();
        }
