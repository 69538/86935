    private void showAllCustomControls() {
        if (isScreenLocked) return;
        autoHideHandler.removeCallbacks(autoHideRunnable);

        if (playerView != null) {
            playerView.showController();
        }
        if (topBarLayout != null) {
            topBarLayout.setVisibility(View.VISIBLE);
        }
        if (sideNavContainer != null) {
            sideNavContainer.setVisibility(View.VISIBLE);
        }

        if (btnZoom != null) {
            btnZoom.postDelayed(() -> btnZoom.requestFocus(), 50);
        }

        resetAutoHideTimer();
    }

    private void hideAllCustomControls() {
        autoHideHandler.removeCallbacks(autoHideRunnable);
        if (playerView != null) {
            playerView.hideController();
        }
        if (topBarLayout != null) {
            topBarLayout.setVisibility(View.GONE);
        }
        if (sideNavContainer != null) {
            sideNavContainer.setVisibility(View.GONE);
        }
    }

    private void resetAutoHideTimer() {
        autoHideHandler.removeCallbacks(autoHideRunnable);
        if (!isScreenLocked) {
            autoHideHandler.postDelayed(autoHideRunnable, 3500);
        }
    }

    private void playNextChannel() {
        if (isScreenLocked) return;
        if (playerView != null) {
            playerView.hideController();
        }

        if (LiveTvActivity.staticChannelList != null && !LiveTvActivity.staticChannelList.isEmpty()) {
            LiveTvActivity.staticCurrentIndex++;
            if (LiveTvActivity.staticCurrentIndex >= LiveTvActivity.staticChannelList.size()) {
                LiveTvActivity.staticCurrentIndex = 0;
            }
            ChannelItem nextChannel = LiveTvActivity.staticChannelList.get(LiveTvActivity.staticCurrentIndex);
            if (nextChannel != null && nextChannel.getStreamUrl() != null) {
                prepareAndPlay(nextChannel.getStreamUrl(), false);
                showDthInfoOverlay(nextChannel, LiveTvActivity.staticCurrentIndex);
            }
        }
    }

    private void playPreviousChannel() {
        if (isScreenLocked) return;
        if (playerView != null) {
            playerView.hideController();
        }

        if (LiveTvActivity.staticChannelList != null && !LiveTvActivity.staticChannelList.isEmpty()) {
            LiveTvActivity.staticCurrentIndex--;
            if (LiveTvActivity.staticCurrentIndex < 0) {
                LiveTvActivity.staticCurrentIndex = LiveTvActivity.staticChannelList.size() - 1;
            }
            ChannelItem prevChannel = LiveTvActivity.staticChannelList.get(LiveTvActivity.staticCurrentIndex);
            if (prevChannel != null && prevChannel.getStreamUrl() != null) {
                prepareAndPlay(prevChannel.getStreamUrl(), false);
                showDthInfoOverlay(prevChannel, LiveTvActivity.staticCurrentIndex);
            }
        }
    }

    private void toggleZoomModes() {
        if (playerView == null || btnZoom == null || player == null) return;

        resizeModeIndex = (resizeModeIndex + 1) % 3;

        switch (resizeModeIndex) {
            case 0:
                playerView.setResizeMode(AspectRatioFrameLayout.RESIZE_MODE_FIT);
                player.setVideoScalingMode(C.VIDEO_SCALING_MODE_SCALE_TO_FIT);
                btnZoom.setText("FIT");
                break;

            case 1:
                playerView.setResizeMode(AspectRatioFrameLayout.RESIZE_MODE_FILL);
                player.setVideoScalingMode(C.VIDEO_SCALING_MODE_SCALE_TO_FIT);
                btnZoom.setText("FILL");
                break;

            case 2:
                playerView.setResizeMode(AspectRatioFrameLayout.RESIZE_MODE_ZOOM);
                player.setVideoScalingMode(C.VIDEO_SCALING_MODE_SCALE_TO_FIT_WITH_CROPPING);
                btnZoom.setText("ZOOM");
                break;
        }

        try {
            playerView.requestLayout();
            View surfaceView = playerView.getVideoSurfaceView();
            if (surfaceView != null) {
                surfaceView.requestLayout();
            }
        } catch (Exception e) {
            Log.e("TV_Scale_Error", "Surface layout bypass failed: " + e.getLocalizedMessage());
        }
    }

    private void triggerPipTransitionMode() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            try {
                PictureInPictureParams.Builder pipBuilder = new PictureInPictureParams.Builder();
                pipBuilder.setAspectRatio(new Rational(16, 9));
                enterPictureInPictureMode(pipBuilder.build());
            } catch (Exception e) {
                Toast.makeText(this, "PiP context mapping missed", Toast.LENGTH_SHORT).show();
            }
        }
    }

    private void launchOfficialMultiTabTracksDialog() {
        if (player == null || isScreenLocked) return;
