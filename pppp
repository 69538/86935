    private OkHttpClient createClient() {
        return new OkHttpClient.Builder()
                .followRedirects(true)
                .followSslRedirects(true)
                .connectTimeout(25, TimeUnit.SECONDS)
                .readTimeout(25, TimeUnit.SECONDS)
                .cookieJar(new CookieJar() {
                    @Override
                    public void saveFromResponse(@NonNull HttpUrl url, @NonNull List<Cookie> cookies) {
                        cookieStore.put(url.host(), cookies);
                    }

                    @NonNull
                    @Override
                    public List<Cookie> loadForRequest(@NonNull HttpUrl url) {
                        return cookieStore.getOrDefault(url.host(), new ArrayList<>());
                    }
                }).build();
    }

    private void fetchCookiesFromJsonUrl(String cookieJsonUrl, String targetStreamUrl, Runnable onCookiesReady) {
        if (!cookieJsonUrl.startsWith("http")) {
            parseCookieJsonData(cookieJsonUrl, targetStreamUrl);
            runOnUiThread(onCookiesReady);
            return;
        }

        OkHttpClient client = MyOkHttpBuilder.getUnsafeOkHttpClient();
        Request request = new Request.Builder().url(cookieJsonUrl).build();

        client.newCall(request).enqueue(new Callback() {
            @Override
            public void onFailure(@NonNull okhttp3.Call call, @NonNull IOException e) {
                Log.e("CookieJson", "Failed to fetch JSON: " + e.getMessage());
                runOnUiThread(onCookiesReady);
            }

            @Override
            public void onResponse(@NonNull okhttp3.Call call, @NonNull Response response) throws IOException {
                if (response.isSuccessful() && response.body() != null) {
                    String jsonStr = response.body().string();
                    parseCookieJsonData(jsonStr, targetStreamUrl);
                }
                runOnUiThread(onCookiesReady);
            }
        });
    }

    private void parseCookieJsonData(String jsonStr, String targetStreamUrl) {
        try {
            jsonStr = jsonStr.trim();
            if (jsonStr.startsWith("[")) {
                JSONArray jsonArray = new JSONArray(jsonStr);
                for (int i = 0; i < jsonArray.length(); i++) {
                    Object item = jsonArray.opt(i);
                    if (item instanceof JSONObject) {
                        JSONObject obj = (JSONObject) item;

                        if (obj.has("cookie")) {
                            extractAndStoreDirectCookie(obj.optString("cookie"), targetStreamUrl);
                        }
                        if (obj.has("ready_to_use_link")) {
                            String rtu = obj.optString("ready_to_use_link");
                            if (rtu.contains("__hdnea__=")) {
                                int idx = rtu.indexOf("__hdnea__=");
                                String sub = rtu.substring(idx);
                                extractAndStoreDirectCookie(sub, targetStreamUrl);
                            }
                        }

                        java.util.Iterator<String> keys = obj.keys();
                        while (keys.hasNext()) {
                            String key = keys.next();
                            String val = obj.optString(key);
                            if (val.contains("__hdnea__=") || key.equalsIgnoreCase("cookie") || (val.contains("st=") && val.contains("exp="))) {
                                extractAndStoreDirectCookie(val, targetStreamUrl);
                            }
                        }
                    } else if (item instanceof String) {
                        extractAndStoreDirectCookie((String) item, targetStreamUrl);
                    }
                }
            } else if (jsonStr.startsWith("{")) {
                JSONObject jsonObject = new JSONObject(jsonStr);
                if (jsonObject.has("cookie")) {
                    extractAndStoreDirectCookie(jsonObject.optString("cookie"), targetStreamUrl);
                }
                java.util.Iterator<String> keys = jsonObject.keys();
                while (keys.hasNext()) {
                    String key = keys.next();
                    Object valObj = jsonObject.opt(key);
                    if (valObj instanceof String) {
                        String val = (String) valObj;
                        if (val.contains("__hdnea__=") || key.equalsIgnoreCase("cookie") || val.contains("st=")) {
                            extractAndStoreDirectCookie(val, targetStreamUrl);
                        }
                    } else if (valObj instanceof JSONArray) {
                        parseCookieJsonData(valObj.toString(), targetStreamUrl);
                    }
                }
            } else {
                extractAndStoreDirectCookie(jsonStr, targetStreamUrl);
            }
        } catch (Exception e) {
            Log.e("CookieJson", "Universal parsing error: " + e.getLocalizedMessage());
        }
    }

    private void extractAndStoreDirectCookie(String cookieString, String targetStreamUrl) {
        if (cookieString == null || cookieString.trim().isEmpty()) return;

        if (cookieString.contains("&")) {
            cookieString = cookieString.split("&")[0];
        }

        String cookieName = "__hdnea__";
        String cookieValue = "";

        if (cookieString.contains("__hdnea__=")) {
            int idx = cookieString.indexOf("__hdnea__=");
            String sub = cookieString.substring(idx + 10);
            cookieValue = sub.contains(";") ? sub.split(";")[0] : sub;
        } else if (cookieString.contains("=")) {
            String[] parts = cookieString.split("=", 2);
            cookieName = parts[0].trim();
            cookieValue = parts[1].trim().split(";")[0];
        } else {
            cookieValue = cookieString.trim();
        }

        if (!cookieValue.isEmpty()) {
            String hostDomain = "";
            String rootDomain = "";

            try {
                if (targetStreamUrl != null && !targetStreamUrl.trim().isEmpty()) {
                    Uri uri = Uri.parse(targetStreamUrl);
                    if (uri != null) {
                        hostDomain = uri.getHost();
                    }
                }
            } catch (Exception ignored) {}

            if (hostDomain == null || hostDomain.trim().isEmpty()) {
                try {
                    Uri fallbackUri = Uri.parse(getStreamUrlFromIntent());
                    hostDomain = fallbackUri.getHost();
                } catch (Exception ignored) {}
            }

            if (hostDomain == null || hostDomain.trim().isEmpty()) {
                hostDomain = "api.streambox.local";
            } else {
                try {
                    String[] parts = hostDomain.split("\\.");
                    if (parts != null && parts.length >= 2) {
                        rootDomain = "." + parts[parts.length - 2] + "." + parts[parts.length - 1];
                    }
                } catch (Exception ignored) {}
            }

            try {
                Cookie cookie = new Cookie.Builder()
                        .name(cookieName)
                        .value(cookieValue)
                        .domain(hostDomain)
                        .build();

                List<Cookie> hostCookies = cookieStore.computeIfAbsent(hostDomain, k -> new ArrayList<>());
                boolean exists = false;
                for (Cookie c : hostCookies) {
                    if (c != null && c.name() != null && c.name().equals(cookieName)) {
                        exists = true;
                        break;
                    }
                }
                if (!exists) {
                    hostCookies.add(cookie);
                }

                if (!rootDomain.isEmpty() && !rootDomain.equals(hostDomain)) {
                    Cookie rootCookie = new Cookie.Builder()
                            .name(cookieName)
                            .value(cookieValue)
                            .domain(rootDomain)
                            .build();
                    List<Cookie> rootCookies = cookieStore.computeIfAbsent(rootDomain, k -> new ArrayList<>());
                    rootCookies.add(rootCookie);
                }
            } catch (Exception e) {
                Log.e("CookieStore", "Failed to build cookie: " + e.getMessage());
            }
        }
    }

    private void prepareAndPlay(String rawUrl, boolean isHotSwap) {
        if (!isHotSwap) tokenRefreshCount = 0;

        String[] mainParts = rawUrl.split("\\|");
        String queryParams = mainParts.length > 1 ? mainParts[1].trim() : "";
        String cookieJsonUrl = "";
        String baseStreamForDynamicDomain = mainParts[0].trim();

        if (!queryParams.isEmpty()) {
            for (String pair : queryParams.split("&")) {
                String[] kv = pair.split("=", 2);
                if (kv.length == 2) {
                    String key = kv[0].trim();
                    String val = kv[1].trim();
                    if (key.equalsIgnoreCase("cookieJson") || key.equalsIgnoreCase("cookie_json")) {
                        cookieJsonUrl = val;
                        break;
                    } else if (key.equalsIgnoreCase("Cookie") && val.startsWith("http")) {
                        cookieJsonUrl = val;
                        break;
                    }
                }
            }
        }

        if (rawUrl.trim().startsWith("[") || rawUrl.trim().startsWith("{")) {
            try {
                String extractedMpd = "";
                String extractedCookie = "";
                String extractedKeyId = "";
                String extractedKey = "";

                if (rawUrl.trim().startsWith("[")) {
                    JSONArray arr = new JSONArray(rawUrl);
                    for (int i = 0; i < arr.length(); i++) {
                        JSONObject obj = arr.optJSONObject(i);
                        if (obj != null) {
                            if (obj.has("ready_to_use_link")) {
                                extractedMpd = obj.optString("ready_to_use_link");
                                break;
                            } else if (obj.has("mpd_url")) {
                                extractedMpd = obj.optString("mpd_url");
                                if (obj.has("cookie")) extractedCookie = obj.optString("cookie");
                                if (obj.has("keyId")) extractedKeyId = obj.optString("keyId");
                                if (obj.has("key")) extractedKey = obj.optString("key");
                                break;
                            }
                        }
                    }
                }

                if (!extractedMpd.isEmpty()) {
                    baseStreamForDynamicDomain = extractedMpd;
                    rawUrl = extractedMpd;
                    if (!rawUrl.contains("|") && (!extractedCookie.isEmpty() || (!extractedKeyId.isEmpty() && !extractedKey.isEmpty()))) {
                        StringBuilder sb = new StringBuilder(rawUrl);
                        boolean hasParam = false;
                        if (!extractedCookie.isEmpty()) {
                            sb.append("|Cookie=").append(extractedCookie);
                            hasParam = true;
                        }
                        if (!extractedKeyId.isEmpty() && !extractedKey.isEmpty()) {
                            sb.append(hasParam ? "&" : "|").append("drmScheme=clearkey&drmLicense=").append(extractedKeyId).append(":").append(extractedKey);
                        }
                        rawUrl = sb.toString();
                    }
                }
            } catch (Exception ignored) {}

            parseCookieJsonData(rawUrl, baseStreamForDynamicDomain);
        }

        if (!cookieJsonUrl.isEmpty()) {
            final String finalRawUrl = rawUrl;
            final String finalBaseStream = baseStreamForDynamicDomain;
            fetchCookiesFromJsonUrl(cookieJsonUrl, finalBaseStream, () -> executeStreamPreparation(finalRawUrl, isHotSwap));
            return;
        }

        if (rawUrl.contains("__hdnea__=")) {
            extractAndStoreDirectCookie(rawUrl, baseStreamForDynamicDomain);
        }

        executeStreamPreparation(rawUrl, isHotSwap);
    }

    private void executeStreamPreparation(String rawUrl, boolean isHotSwap) {
        String[] parts = rawUrl.split("\\|");
        String initialUrl = parts[0].trim();
        String params = parts.length > 1 ? parts.length > 1 ? parts[1].trim() : "" : "";

        // 🔄 SharedPreferences se dynamic proxy/worker domains get karo, strong default fallback ke sath
        android.content.SharedPreferences prefs = getSharedPreferences("sys_blob_store", MODE_PRIVATE);
        String proxyExtns = prefs.getString("extn", "workers.dev,pages.dev,proxy,redirect");

        boolean isProxyOrWorker = false;
        try {
            if (proxyExtns != null && !proxyExtns.trim().isEmpty()) {
                String[] extnList = proxyExtns.split(",");
                for (String extn : extnList) {
                    String trimmedExtn = extn.trim();
                    if (!trimmedExtn.isEmpty() && initialUrl.contains(trimmedExtn)) {
                        isProxyOrWorker = true;
                        break;
                    }
                }
            }
        } catch (Exception ignored) {}

        String lowerUrl = initialUrl.toLowerCase();
        if (!isProxyOrWorker && (lowerUrl.endsWith(".m3u8") || lowerUrl.contains(".m3u8?") || lowerUrl.contains(".php/") || lowerUrl.endsWith(".mpd") || lowerUrl.endsWith(".mp4") || lowerUrl.endsWith(".ts"))) {
            runOnUiThread(() -> startStreaming(initialUrl, params, isHotSwap));
            return;
        }

        new Thread(() -> {
            try {
                if (isHotSwap) {
                    final String cleanUrl = initialUrl;
                    runOnUiThread(() -> startStreaming(cleanUrl, "", true));
                    return;
                }

                OkHttpClient client = createClient();
                okhttp3.Request.Builder rb = new okhttp3.Request.Builder()
                        .url(initialUrl)
                        .get()
                        .header("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")
                        .header("Accept", "*/*");

                if (!params.isEmpty()) {
                    for (String pair : params.split("&")) {
                        String[] kv = pair.split("=", 2);
                        if (kv.length == 2) {
                            String k = kv[0].trim();
                            String v = kv[1].trim();
                            if (!k.equalsIgnoreCase("cookieJson") && !k.equalsIgnoreCase("cookie_json")) {
                                if (k.equalsIgnoreCase("Cookie") && v.startsWith("http")) {
                                    continue;
                                }
                                rb.header(k, v);
                            }
                        }
                    }
                }

                try (okhttp3.Response response = client.newCall(rb.build()).execute()) {
                    String finalUrl = response.request().url().toString();

                    if (finalUrl.contains("__hdnea__=")) {
                        try {
                            Uri redirectedUri = Uri.parse(finalUrl);
                            String tokenQuery = redirectedUri.getQueryParameter("__hdnea__");
                            if (tokenQuery != null && !tokenQuery.isEmpty()) {
                                extractAndStoreDirectCookie("__hdnea__=" + tokenQuery, finalUrl);
                            } else {
                                String sub = finalUrl.substring(finalUrl.indexOf("__hdnea__="));
                                extractAndStoreDirectCookie(sub, finalUrl);
                            }
                        } catch (Exception e) {
                            extractAndStoreDirectCookie(finalUrl, finalUrl);
                        }
                    }

                    final String targetUrl = finalUrl;
                    final String targetParams = params;
                    runOnUiThread(() -> startStreaming(targetUrl, targetParams, false));
                }
            } catch (Exception e) {
                String[] fallbackParts = rawUrl.split("\\|");
                String fallbackUrl = fallbackParts[0].trim();
                String fallbackParams = fallbackParts.length > 1 ? fallbackParts[1].trim() : "";

                if (fallbackUrl.contains("__hdnea__=")) {
                    extractAndStoreDirectCookie(fallbackUrl, fallbackUrl);
                }

                runOnUiThread(() -> startStreaming(fallbackUrl, fallbackParams, isHotSwap));
            }
        }).start();
    }

    private void startStreaming(String streamUrl, String params, boolean isHotSwap) {
        try {
            Map<String, String> headers = new HashMap<>();
            String drmLicense = "";

            if (!params.isEmpty()) {
                for (String pair : params.split("&")) {
                    String[] kv = pair.split("=", 2);
                    if (kv.length == 2) {
                        String k = kv[0].trim();
                        String v = kv[1].trim();
                        if (k.equalsIgnoreCase("drmLicense")) {
                            drmLicense = v;
                        } else if (!k.equalsIgnoreCase("Cookie") || !v.startsWith("http")) {
                            headers.put(k, v);
                        }
                    }
                }
            }

            if (!headers.containsKey("Cookie")) {
                if (streamUrl.contains("__hdnea__=")) {
                    int startIndex = streamUrl.indexOf("__hdnea__=");
                    int endIndex = streamUrl.indexOf("&", startIndex);
                    String cookieSub = (endIndex == -1) ? streamUrl.substring(startIndex) : streamUrl.substring(startIndex, endIndex);
                    headers.put("Cookie", cookieSub);
                    extractAndStoreDirectCookie(cookieSub, streamUrl);
                } else {
                    try {
                        Uri parsedUri = Uri.parse(streamUrl);
                        String host = parsedUri.getHost();
                        if (host != null && cookieStore.containsKey(host)) {
                            List<Cookie> cookies = cookieStore.get(host);
                            if (cookies != null && !cookies.isEmpty()) {
                                StringBuilder sb = new StringBuilder();
                                for (int i = 0; i < cookies.size(); i++) {
                                    if (i > 0) sb.append("; ");
                                    sb.append(cookies.get(i).name()).append("=").append(cookies.get(i).value());
                                }
                                headers.put("Cookie", sb.toString());
                            }
                        }
                    } catch (Exception ignored) {}
                }
            }

            if (!headers.containsKey("Accept")) {
                headers.put("Accept", "*/*");
            }

            DefaultHttpDataSource.Factory httpDataSourceFactory = new DefaultHttpDataSource.Factory()
                    .setUserAgent("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")
                    .setConnectTimeoutMs(25000)
                    .setReadTimeoutMs(25000)
                    .setAllowCrossProtocolRedirects(true)
                    .setKeepPostFor302Redirects(true);

            if (!headers.isEmpty()) {
                httpDataSourceFactory.setDefaultRequestProperties(headers);
            }

            DefaultExtractorsFactory extractorsFactory = new DefaultExtractorsFactory()
                    .setTsExtractorFlags(
                            DefaultTsPayloadReaderFactory.FLAG_ALLOW_NON_IDR_KEYFRAMES
                                    | DefaultTsPayloadReaderFactory.FLAG_DETECT_ACCESS_UNITS
                    )
                    .setTsExtractorTimestampSearchBytes(1500 * 188);

            DefaultMediaSourceFactory sourceFactory = new DefaultMediaSourceFactory(this, extractorsFactory)
                    .setDataSourceFactory(httpDataSourceFactory);

            if (!drmLicense.isEmpty()) {
                final String finalDrmLicense = drmLicense;
                if (finalDrmLicense.startsWith("http")) {
                    sourceFactory.setDrmSessionManagerProvider(unused -> {
                        HttpMediaDrmCallback httpDrmCallback = new HttpMediaDrmCallback(finalDrmLicense, httpDataSourceFactory);
                        for (Map.Entry<String, String> entry : headers.entrySet()) {
                            httpDrmCallback.setKeyRequestProperty(entry.getKey(), entry.getValue());
                        }
                        httpDrmCallback.setKeyRequestProperty("Referer", streamUrl);
                        return new DefaultDrmSessionManager.Builder()
                                .setUuidAndExoMediaDrmProvider(C.CLEARKEY_UUID, FrameworkMediaDrm.DEFAULT_PROVIDER)
                                .build(httpDrmCallback);
                    });
                } else {
                    String[] keys = drmLicense.split(":");
                    if (keys.length >= 2) {
                        String drmJson = "{\"keys\":[{\"kty\":\"oct\",\"k\":\"" + hexToBase64Url(keys[1]) + "\",\"kid\":\"" + hexToBase64Url(keys[0]) + "\"}],\"type\":\"temporary\"}";
                        sourceFactory.setDrmSessionManagerProvider(unused -> new DefaultDrmSessionManager.Builder()
                                .setUuidAndExoMediaDrmProvider(C.CLEARKEY_UUID, FrameworkMediaDrm.DEFAULT_PROVIDER)
                                .build(new LocalMediaDrmCallback(drmJson.getBytes())));
                    }
                }
            }

            // 🚀 FAST ZAPPING & SMOOTH SWITCH
            if (player == null) {
                DefaultRenderersFactory renderersFactory = new DefaultRenderersFactory(this)
                        .setExtensionRendererMode(DefaultRenderersFactory.EXTENSION_RENDERER_MODE_PREFER)
                        .setEnableDecoderFallback(true);

                TrackSelectionParameters trackSelectionParameters = new TrackSelectionParameters.Builder(this)
                        .setSelectUndeterminedTextLanguage(true)
                        .build();

                DefaultLoadControl fastLoadControl = new DefaultLoadControl.Builder()
                        .setBufferDurationsMs(
                                2000,
                                10000,
                                500,
                                1000
                        ).build();

                player = new ExoPlayer.Builder(this, renderersFactory)
                        .setMediaSourceFactory(sourceFactory)
                        .setLoadControl(fastLoadControl)
                        .build();

                player.setTrackSelectionParameters(trackSelectionParameters);

                // ✅ 1st Time Initialization par Video Scaling Mode FILL ke compatible set kiya
                player.setVideoScalingMode(C.VIDEO_SCALING_MODE_SCALE_TO_FIT);

                playerView.setPlayer(player);
                setupPlayerErrorListener();
            }

            // ✅ Naya Safe Code (Purana logic safe rahega aur tokens strip nahi honge)
            String cleanStreamUrl = streamUrl;
            if (cleanStreamUrl.contains("?") && !cleanStreamUrl.contains(".m3u8") && !cleanStreamUrl.contains(".mpd")) {
                cleanStreamUrl = cleanStreamUrl.split("\\?")[0];
            }

            MediaItem.Builder mediaItemBuilder = new MediaItem.Builder().setUri(Uri.parse(cleanStreamUrl));

            String cleanPath = cleanStreamUrl.toLowerCase();

            if (cleanPath.endsWith(".mpd") || streamUrl.toLowerCase().contains("dash") || streamUrl.toLowerCase().contains("manifest")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.APPLICATION_MPD);
            } else if (cleanPath.endsWith(".m3u8") || cleanPath.contains(".m3u8") || streamUrl.toLowerCase().contains("play.php") || streamUrl.toLowerCase().contains("hls") || cleanPath.endsWith(".php") || cleanPath.contains(".php/")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.APPLICATION_M3U8);
            } else if (cleanPath.endsWith(".ts")) {
                mediaItemBuilder.setMimeType("video/mp2t");
            }
            else if (cleanPath.endsWith(".mp4") || cleanPath.endsWith(".m4v")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.VIDEO_MP4);
            } else if (cleanPath.endsWith(".mkv")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.VIDEO_MATROSKA);
            } else if (cleanPath.endsWith(".webm")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.VIDEO_WEBM);
            } else if (cleanPath.endsWith(".3gp") || cleanPath.endsWith(".3gpp")) {
                mediaItemBuilder.setMimeType("video/3gpp");
            } else if (cleanPath.endsWith(".avi")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.VIDEO_AVI);
            } else if (cleanPath.endsWith(".flv")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.VIDEO_FLV);
            } else if (cleanPath.endsWith(".mov")) {
                mediaItemBuilder.setMimeType("video/quicktime");
            }
            else if (cleanPath.endsWith(".mp3")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.AUDIO_MPEG);
            } else if (cleanPath.endsWith(".aac")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.AUDIO_AAC);
            } else if (cleanPath.endsWith(".m4a")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.AUDIO_MP4);
            } else if (cleanPath.endsWith(".flac")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.AUDIO_FLAC);
            } else if (cleanPath.endsWith(".ogg") || cleanPath.endsWith(".opus")) {
                mediaItemBuilder.setMimeType(androidx.media3.common.MimeTypes.AUDIO_OGG);
            }

            MediaItem mediaItem = mediaItemBuilder.build();

            if (isHotSwap) {
                long currentPos = player.getCurrentPosition();
                player.setMediaSource(sourceFactory.createMediaSource(mediaItem), false);
                player.seekTo(currentPos);
            } else {
                player.setMediaSource(sourceFactory.createMediaSource(mediaItem));
                if (playbackPosition > 0) {
                    player.seekTo(currentWindow, playbackPosition);
                    playbackPosition = 0;
                }
            }

            // ✅ 1st Time play hote hi FILL mode enforce aur View requestLayout trigger
            if (playerView != null) {
                playerView.setResizeMode(AspectRatioFrameLayout.RESIZE_MODE_FILL);
                playerView.requestLayout();
            }
            if (player != null) {
                player.setVideoScalingMode(C.VIDEO_SCALING_MODE_SCALE_TO_FIT);
            }
            if (btnZoom != null) {
                btnZoom.setText("FILL");
            }
            resizeModeIndex = 1;

            player.setPlayWhenReady(true);
            player.prepare();
            player.play();

            playerView.post(() -> {
                View exoBuffenering = playerView.findViewById(androidx.media3.ui.R.id.exo_buffering);
                if (exoBuffenering instanceof ProgressBar) {
                    ProgressBar progressBar = (ProgressBar) exoBuffenering;
                    int sizeInPx = (int) (65 * getResources().getDisplayMetrics().density);
                    ViewGroup.LayoutParams paramsLayout = progressBar.getLayoutParams();
                    if (paramsLayout != null) {
                        paramsLayout.width = sizeInPx;
                        paramsLayout.height = sizeInPx;
                        progressBar.setLayoutParams(paramsLayout);
                    }
                    progressBar.getIndeterminateDrawable().setColorFilter(Color.WHITE, PorterDuff.Mode.SRC_IN);
                }
            });

        } catch (Exception e) {
            runOnUiThread(() -> Toast.makeText(this, "Error: " + e.getMessage(), Toast.LENGTH_LONG).show());
        }
    }

    private void setupPlayerErrorListener() {
        if (player == null) return;
        player.addListener(new Player.Listener() {
            @Override
            public void onPlayerError(@NonNull PlaybackException error) {
                Log.e("PlayerError", "ExoPlayer Error Code: " + error.errorCode + " [" + error.getErrorCodeName() + "], Message: " + error.getMessage(), error);

                if (tokenRefreshCount >= 1) {
                    runOnUiThread(() -> {
                        tokenRefreshCount = 0;
                        if (player != null) player.stop();
                        Toast.makeText(PlayerActivity.this, "Playback Error", Toast.LENGTH_LONG).show();
                    });
                    return;
                }
                tokenRefreshCount++;
                new Handler(Looper.getMainLooper()).postDelayed(() -> {
                    if (isFinishing() || isDestroyed() || player == null) return;
                    Intent intent = getIntent();
                    String sharedData = intent.getStringExtra("url");
                    if (sharedData == null && intent.getData() != null)
                        sharedData = intent.getData().toString();

                    if (sharedData != null && sharedData.contains("|")) {
                        String cleanUrl = sharedData.split("\\|")[0].trim();
                        intent.putExtra("url", cleanUrl);
                        setIntent(intent);
                        prepareAndPlay(cleanUrl, true);
                    } else {
                        player.prepare();
                        player.play();
                    }
                }, 1000);
            }

            @Override
            public void onPlaybackStateChanged(int playbackState) {
                if (playbackState == Player.STATE_READY) {
                    tokenRefreshCount = 0;

                    // ✅ Stream Ready hote hi Surface View ko FILL format me update
                    if (playerView != null) {
                        playerView.setResizeMode(AspectRatioFrameLayout.RESIZE_MODE_FILL);
                        View surface = playerView.getVideoSurfaceView();
                        if (surface != null) {
                            surface.requestLayout();
                        }
                    }

                    ImageView ivWatermark = findViewById(R.id.iv_watermark);
                    if (ivWatermark != null) {
                        ivWatermark.setVisibility(View.VISIBLE);
                    }
                    runOnUiThread(() -> updateDthQualityAndAudioBadges());
                } else if (playbackState == Player.STATE_ENDED) {
                    if (player != null) {
                        player.seekToDefaultPosition();
                        player.prepare();
                        player.play();
                    }
                }
            }

            @Override
            public void onTracksChanged(@NonNull androidx.media3.common.Tracks tracks) {
                runOnUiThread(() -> updateDthQualityAndAudioBadges());
            }

            @Override
            public void onVideoSizeChanged(@NonNull androidx.media3.common.VideoSize videoSize) {
                runOnUiThread(() -> {
                    if (playerView != null) {
                        playerView.setResizeMode(AspectRatioFrameLayout.RESIZE_MODE_FILL);
                    }
                    updateDthQualityAndAudioBadges();
                });
            }
        });
    }

    private String hexToBase64Url(String hex) {
        try {
            int len = hex.length();
            byte[] data = new byte[len / 2];
            for (int i = 0; i < len; i += 2)
                data[i / 2] = (byte) ((Character.digit(hex.charAt(i), 16) << 4) + Character.digit(hex.charAt(i + 1), 16));
            return Base64.encodeToString(data, Base64.URL_SAFE | Base64.NO_PADDING | Base64.NO_WRAP);
        } catch (Exception e) {
            return "";
        }
    }

