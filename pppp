    @Override
    public boolean dispatchKeyEvent(KeyEvent event) {
        int keyCode = event.getKeyCode();
        int action = event.getAction();

        // 1. Agar Screen Locked hai to sirf Back Button ya Unlock Button chalna chahiye
        if (isScreenLocked) {
            if (keyCode == KeyEvent.KEYCODE_BACK) {
                return super.dispatchKeyEvent(event);
            }
            if (lockOverlay != null && lockOverlay.getVisibility() == View.VISIBLE) {
                if (btnUnlockFloating != null && btnUnlockFloating.hasFocus()) {
                    return super.dispatchKeyEvent(event);
                }
            }
            return true;
        }

        // 2. Agar Quick Menu VISIBLE hai
        if (quickMenuOverlay != null && quickMenuOverlay.getVisibility() == View.VISIBLE) {
            return super.dispatchKeyEvent(event);
        }

        // 🎯 3. RIGHT BUTTON DABANE PAR QUALITY LAYOUT DIKHE
        if (keyCode == KeyEvent.KEYCODE_DPAD_RIGHT) {
            if (topBarLayout == null || topBarLayout.getVisibility() != View.VISIBLE) {
                if (action == KeyEvent.ACTION_DOWN) {
                    hideDthOverlayImmediately();
                    launchOfficialMultiTabTracksDialog();
                }
                return true;
            } else {
                resetAutoHideTimer();
                return super.dispatchKeyEvent(event);
            }
        }

        // 4. Remote LEFT dabane par Quick Menu open hoga
        if (keyCode == KeyEvent.KEYCODE_DPAD_LEFT && (topBarLayout == null || topBarLayout.getVisibility() != View.VISIBLE)) {
            if (action == KeyEvent.ACTION_DOWN) {
                toggleQuickMenu();
            }
            return true;
        }

        // 5. DPAD UP ya CHANNEL UP
        if (keyCode == KeyEvent.KEYCODE_DPAD_UP || keyCode == KeyEvent.KEYCODE_CHANNEL_UP) {
            if (topBarLayout != null && topBarLayout.getVisibility() == View.VISIBLE) {
                resetAutoHideTimer();
                return super.dispatchKeyEvent(event);
            }
            if (action == KeyEvent.ACTION_DOWN) {
                playNextChannel();
            }
            return true;
        }

        // 6. DPAD DOWN ya CHANNEL DOWN
        if (keyCode == KeyEvent.KEYCODE_DPAD_DOWN || keyCode == KeyEvent.KEYCODE_CHANNEL_DOWN) {
            if (topBarLayout != null && topBarLayout.getVisibility() == View.VISIBLE) {
                resetAutoHideTimer();
                return super.dispatchKeyEvent(event);
            }
            if (action == KeyEvent.ACTION_DOWN) {
                playPreviousChannel();
            }
            return true;
        }

        // 7. DPAD Navigation
        if (keyCode == KeyEvent.KEYCODE_DPAD_LEFT) {
            if (topBarLayout != null && topBarLayout.getVisibility() == View.VISIBLE) {
                resetAutoHideTimer();
                return super.dispatchKeyEvent(event);
            }
        }

        // 🔢 8. NUMBER KEYPAD ZAPPING (0-9 Remote Keys)
        if (keyCode >= KeyEvent.KEYCODE_0 && keyCode <= KeyEvent.KEYCODE_9) {
            if (action == KeyEvent.ACTION_DOWN) {
                int digit = keyCode - KeyEvent.KEYCODE_0;
                handleNumberZappingInput(digit);
            }
            return true;
        } else if (keyCode >= KeyEvent.KEYCODE_NUMPAD_0 && keyCode <= KeyEvent.KEYCODE_NUMPAD_9) {
            if (action == KeyEvent.ACTION_DOWN) {
                int digit = keyCode - KeyEvent.KEYCODE_NUMPAD_0;
                handleNumberZappingInput(digit);
            }
            return true;
        }

        // 9. OK / CENTER BUTTON FIX (TV Remote) - Tap aur Long Press dono ke liye
        if (keyCode == KeyEvent.KEYCODE_DPAD_CENTER || keyCode == KeyEvent.KEYCODE_ENTER || keyCode == KeyEvent.KEYCODE_NUMPAD_ENTER) {
            if (topBarLayout != null && topBarLayout.getVisibility() == View.VISIBLE) {
                resetAutoHideTimer();
                return super.dispatchKeyEvent(event);
            }

            if (action == KeyEvent.ACTION_DOWN) {
                event.startTracking();
                if (event.getRepeatCount() > 0) {
                    // Long Press par DTH Info Overlay show hoga
                    hideDthOverlayImmediately();
                    if (LiveTvActivity.staticChannelList != null && LiveTvActivity.staticCurrentIndex >= 0 && LiveTvActivity.staticCurrentIndex < LiveTvActivity.staticChannelList.size()) {
                        ChannelItem currentCh = LiveTvActivity.staticChannelList.get(LiveTvActivity.staticCurrentIndex);
                        showDthInfoOverlay(currentCh, LiveTvActivity.staticCurrentIndex);
                    }
                    return true;
                }
            } else if (action == KeyEvent.ACTION_UP) {
                if (!event.isCanceled()) {
                    // Normal Short Tap par Custom Controls open honge
                    hideDthOverlayImmediately();
                    showAllCustomControls();
                }
                return true;
            }
            return true;
        }

        return super.dispatchKeyEvent(event);
    }

