    private String getStreamUrlFromIntent() {
        String rawUrl = null;
        Intent intent = getIntent();

        if (intent != null) {
            if (intent.hasExtra("stream_url")) {
                rawUrl = intent.getStringExtra("stream_url");
            } else if (intent.hasExtra("STREAM_URL")) {
                rawUrl = intent.getStringExtra("STREAM_URL");
            } else if (intent.hasExtra("url")) {
                rawUrl = intent.getStringExtra("url");
            } else if (intent.hasExtra("URL")) {
                rawUrl = intent.getStringExtra("URL");
            }

            if (rawUrl == null && Intent.ACTION_SEND.equals(intent.getAction()) && "text/plain".equals(intent.getType())) {
                rawUrl = intent.getStringExtra(Intent.EXTRA_TEXT);
            }

            if (rawUrl == null && intent.getData() != null) {
                Uri data = intent.getData();
                rawUrl = data.getQueryParameter("url");
                if (rawUrl == null || rawUrl.trim().isEmpty()) {
                    rawUrl = data.toString();
                }
            }
        }

        if (rawUrl == null || rawUrl.trim().isEmpty()) {
            rawUrl = "";
        }

        return rawUrl;
    }

