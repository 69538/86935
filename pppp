    private void showQuickMenu() {
        if (isScreenLocked || quickMenuOverlay == null) return;

        hideAllCustomControls();
        if (playerView != null) {
            playerView.hideController();
            playerView.setUseController(false);
        }

        hideDthOverlayImmediately();
        quickMenuOverlay.setVisibility(View.VISIBLE);
        quickMenuOverlay.setAlpha(0f);
        quickMenuOverlay.setTranslationX(-60f);
        quickMenuOverlay.animate().translationX(0f).alpha(1f).setDuration(250).start();

        if (rvQuickChannels != null && isTvDevice(this)) {
            rvQuickChannels.postDelayed(() -> rvQuickChannels.requestFocus(), 100);
        }
    }

    private void hideQuickMenu() {
        if (quickMenuOverlay == null || quickMenuOverlay.getVisibility() != View.VISIBLE) return;

        quickMenuOverlay.animate().translationX(-60f).alpha(0f).setDuration(200).withEndAction(() -> {
            quickMenuOverlay.setVisibility(View.GONE);
            if (playerView != null) {
                playerView.setUseController(true);
            }
        }).start();
    }

