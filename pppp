    private void showDthInfoOverlay(ChannelItem channel, int channelIndex) {
        LinearLayout dthOverlay = findViewById(R.id.dth_info_overlay);
        TextView tvChannelName = findViewById(R.id.tv_dth_channel_name);
        TextView tvDateTime = findViewById(R.id.tv_dth_date_time);
        TextView tvStatus = findViewById(R.id.tv_dth_status);
        ImageView ivLogo = findViewById(R.id.iv_dth_logo);

        TextView tvEpgTitle = findViewById(R.id.tv_dth_epg_title);
        TextView tvEpgTime = findViewById(R.id.tv_dth_epg_time);
        TextView tvNextEpg = findViewById(R.id.tv_dth_next_epg);
        ProgressBar pbEpgProgress = findViewById(R.id.pb_dth_epg_progress);

        if (dthOverlay == null) return;

        String chName = (channel != null && channel.getName() != null) ? channel.getName() : "Live Channel";
        String formattedText = (channelIndex + 1) + " • " + chName.toUpperCase();

        if (tvChannelName != null) {
            tvChannelName.setText(formattedText);
        }

        if (tvChannelTitle != null) {
            tvChannelTitle.setText(formattedText);
        }

        String category = (channel != null && channel.getGroupTitle() != null && !channel.getGroupTitle().trim().isEmpty())
                ? channel.getGroupTitle().trim()
                : "General Broadcast";

        if (tvStatus != null) {
            tvStatus.setText(category + " • Live Stream HD");
        }

        if (tvDateTime != null) {
            tvDateTime.setText(getCurrentDateTimeString());
        }

        updateDthQualityAndAudioBadges();

        if (ivLogo != null && (ivLogo.getDrawable() == null || ivLogo.getTag() == null)) {
            ivLogo.setImageResource(R.drawable.image_channel_loader);
        }

        // ⚡ Fast Single-Thread Executor for EPG & Logo fetching with optimized timeouts
        if (channel != null) {
            final String tvgId = channel.getTvgId();
            final String channelTitle = channel.getName();
            final String logoUrl = (channel.getLogoUrl() != null) ? channel.getLogoUrl().trim() : "";

            if (ivLogo != null && !logoUrl.isEmpty()) {
                ivLogo.setTag(logoUrl);
            }

            if (currentEpgTask != null && !currentEpgTask.isDone()) {
                currentEpgTask.cancel(true);
            }

            currentEpgTask = epgExecutor.submit(() -> {
                try {
                    if (Thread.currentThread().isInterrupted()) return;

                    EpgProgram currentShow = EpgManager.getInstance().getCurrentProgram(tvgId, channelTitle);
                    EpgProgram nextShow = EpgManager.getInstance().getNextProgram(tvgId, channelTitle);
                    java.text.SimpleDateFormat timeFormat = new java.text.SimpleDateFormat("hh:mm a", java.util.Locale.getDefault());

                    String currentTitleText = (currentShow != null) ? currentShow.title : category.toUpperCase();
                    String currentTimeText = "Live Broadcast";
                    int currentProgressVal = 0;
                    boolean hasProgress = false;

                    if (currentShow != null) {
                        String startTime = timeFormat.format(new java.util.Date(currentShow.startTime));
                        String endTime = timeFormat.format(new java.util.Date(currentShow.endTime));
                        currentTimeText = startTime + " - " + endTime;
                        currentProgressVal = currentShow.getProgressPercentage();
                        hasProgress = true;
                    }

                    String nextShowFormatted = "No EPG Available";
                    if (nextShow != null) {
                        String nextStartTime = timeFormat.format(new java.util.Date(nextShow.startTime));
                        long diffMillis = nextShow.startTime - System.currentTimeMillis();
                        String timeRemainingStr = "";
                        if (diffMillis > 0) {
                            long minutes = java.util.concurrent.TimeUnit.MILLISECONDS.toMinutes(diffMillis) % 60;
                            long hours = java.util.concurrent.TimeUnit.MILLISECONDS.toHours(diffMillis);

                            if (hours > 0) {
                                timeRemainingStr = " (in " + hours + "h " + minutes + "m)";
                            } else {
                                timeRemainingStr = " (in " + minutes + " mins)";
                            }
                        }
                        nextShowFormatted = nextShow.title + " (" + nextStartTime + ")" + timeRemainingStr;
                    }

                    android.graphics.Bitmap bmp = null;
                    if (!logoUrl.isEmpty()) {
                        try {
                            java.net.URL url = new java.net.URL(logoUrl);
                            java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
                            conn.setConnectTimeout(800);
                            conn.setReadTimeout(800);
                            conn.connect();

                            if (conn.getResponseCode() == java.net.HttpURLConnection.HTTP_OK) {
                                java.io.InputStream in = conn.getInputStream();
                                bmp = android.graphics.BitmapFactory.decodeStream(in);
                                in.close();
                            }
                        } catch (Exception ignored) {}
                    }

                    if (Thread.currentThread().isInterrupted()) return;

                    final String finalCurrTitle = currentTitleText;
                    final String finalCurrTime = currentTimeText;
                    final boolean finalHasProgress = hasProgress;
                    final int finalProgressVal = currentProgressVal;
                    final String finalNextText = nextShowFormatted;
                    final android.graphics.Bitmap finalBmp = bmp;

                    runOnUiThread(() -> {
                        if (dthOverlay.getVisibility() == View.VISIBLE) {
                            if (tvEpgTitle != null) tvEpgTitle.setText(finalCurrTitle);
                            if (tvEpgTime != null) tvEpgTime.setText(finalCurrTime);

                            if (pbEpgProgress != null) {
                                if (finalHasProgress) {
                                    pbEpgProgress.setVisibility(View.VISIBLE);
                                    pbEpgProgress.setProgress(finalProgressVal);
                                } else {
                                    pbEpgProgress.setVisibility(View.INVISIBLE);
                                }
                            }

                            if (tvNextEpg != null) {
                                tvNextEpg.setText(finalNextText);
                                tvNextEpg.setVisibility(View.VISIBLE);
                            }

                            if (ivLogo != null && finalBmp != null && logoUrl.equals(ivLogo.getTag())) {
                                ivLogo.setImageBitmap(finalBmp);
                            }
                        }
                    });
                } catch (Exception ignored) {}
            });
        }

        if (dthOverlayRunnable != null) {
            dthOverlayHandler.removeCallbacks(dthOverlayRunnable);
        }

        if (dthOverlay.getVisibility() != View.VISIBLE) {
            dthOverlay.setTranslationY(0f);
            dthOverlay.setAlpha(1.0f);
            dthOverlay.setVisibility(View.VISIBLE);
        }

        dthOverlayRunnable = () -> {
            dthOverlay.animate()
                    .alpha(0.0f)
                    .setDuration(300)
                    .withEndAction(() -> {
                        dthOverlay.setVisibility(View.GONE);
                        dthOverlay.setAlpha(1.0f);
                    })
                    .start();
        };

        dthOverlayHandler.postDelayed(dthOverlayRunnable, 4000);
    }

    private void hideDthOverlayImmediately() {
        LinearLayout dthOverlay = findViewById(R.id.dth_info_overlay);
        if (dthOverlay != null) {
            if (dthOverlayRunnable != null) {
                dthOverlayHandler.removeCallbacks(dthOverlayRunnable);
            }
            dthOverlay.animate().cancel();
            dthOverlay.setVisibility(View.GONE);
        }
    }

